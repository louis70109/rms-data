{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RMS-Guide",
  "version": "1.0.0",
  "identifier": "net.nijialin.rmsdata",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RMS 攻略庫",
        "width": 1280,
        "height": 860,
        "minWidth": 420,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "louis70109",
    "shortDescription": "RMS 攻略庫（離線閱讀）",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGRTEyQkFFQjI1Rjg1RUQKUldUdGhWK3lyaXZoRDBqU3VYSUdoMTdFK2xSTmlxQ3VRNytvdjNRNVdpU0VpelNPUmFGM1I5WVAK",
      "endpoints": [
        "https://github.com/louis70109/rms-data/releases/latest/download/latest.json"
      ]
    }
  }
}
